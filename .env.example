# Скопируйте в .env (в git не попадает) и задайте свои пароли.
POSTGRES_PASSWORD=change-me
MQTT_PASSWORD=change-me-server
PHONE_PASSWORD=change-me-phone
ESP32_PASSWORD=change-me-esp32
# Синтетика: --synthetic --mqtt mqtt
# Телефон-камера (нужен VISION=1): --camera http://192.168.1.21:8080/video --mqtt mqtt --device imu_001
APP_ARGS=--synthetic --mqtt mqtt
VISION=0
